# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=neoedge
POSTGRES_USER=neoedge
POSTGRES_PASSWORD=replace_with_generated_password

# ── WAX Blockchain ────────────────────────────────────────────────────────────
# Optional single preferred SHIP endpoint. Leave blank to use WAX_SHIP_ENDPOINTS rotation.
WAX_SHIP_ENDPOINT=
# Comma-separated fallback SHIP websocket endpoints. Public SHIP endpoints change often; override this list when a provider publishes a current endpoint.
WAX_SHIP_ENDPOINTS=wss://wax.eosphere.io/ship,wss://wax.eu.eosamsterdam.net/ship,wss://api.waxsweden.org/ship
HYPERION_ENDPOINT=https://wax.eosusa.io
SHIP_ENABLED=true
HYPERION_FALLBACK_ENABLED=true
HYPERION_FALLBACK_INTERVAL_SECONDS=60
HYPERION_INITIAL_LOOKBACK_HOURS=168
HYPERION_REQUEST_TIMEOUT_SECONDS=20
SHIP_RECONNECT_DELAY_SECONDS=5
START_BLOCK=0
REPLAY_ENABLED=true
# Use swap.neo for production; pass test.pasha to deploy.bat for testnet/local validation.
CONTRACT_ACCOUNT=swap.neo
# Keep this aligned with the on-chain setfee value used by the router contract.
NEO_ROUTE_FEE_BPS=30

# ── API ────────────────────────────────────────────────────────────────────────
ADMIN_SECRET=replace_with_generated_admin_secret
# Comma-separated allowed CORS origins. Use * for development only.
ALLOWED_ORIGINS=http://localhost:15173,http://localhost:3177,https://yourdomain.com
ALCOR_ENDPOINT=https://wax.alcor.exchange
WAX_RPC_ENDPOINT=https://wax.greymass.com
DATA_RETENTION_DAYS=30
DATA_RETENTION_CLEANUP_INTERVAL_HOURS=6

# ── Host ports ───────────────────────────────────────────────────────────────
# The frontend is served by the `serve` container; backend exposes API + SignalR separately.
APP_HOST_PORT=15173
API_HOST_PORT=15174
# Use /api and /hub only when your public web server routes those paths to the backend.
# If the backend is exposed separately, use full HTTPS URLs such as:
# PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# PUBLIC_HUB_URL=https://api.yourdomain.com/hub
PUBLIC_API_BASE_URL=/api
PUBLIC_HUB_URL=/hub

# ── Dry-run arbitrage monitor ────────────────────────────────────────────────
# Posts quote-only WAX round-trip opportunities to Discord. It never signs or executes trades.
ARBITRAGE_SCANNER_ENABLED=false
ARBITRAGE_DISCORD_WEBHOOK_URL=
ARBITRAGE_SCAN_INTERVAL_SECONDS=300
ARBITRAGE_MAX_INPUT_WAX=100
ARBITRAGE_PROBE_WAX_AMOUNTS=5,10,25,50,100
ARBITRAGE_SLIPPAGE=2
ARBITRAGE_MAX_HOPS=6
# Set to 0 to scan every token in the catalog. Keep a cap when using public Alcor endpoints.
ARBITRAGE_MAX_TOKENS_PER_SCAN=150
ARBITRAGE_MIN_PROFIT_PERCENT=0.1
ARBITRAGE_MIN_PROFIT_WAX=0.01
ARBITRAGE_ALERT_TOP_COUNT=10
ARBITRAGE_ALERT_COOLDOWN_MINUTES=30
ARBITRAGE_NO_OPPORTUNITY_HEARTBEAT_MINUTES=60
ARBITRAGE_REQUEST_DELAY_MILLISECONDS=100

# Optional automatic execution. Keep disabled until the account is funded and
# the signer settings have been verified with a small ARBITRAGE_MAX_EXECUTION_WAX.
ARBITRAGE_EXECUTION_ENABLED=false
ARBITRAGE_ACCOUNT=
ARBITRAGE_PERMISSION=active
ARBITRAGE_PRIVATE_KEY=
ARBITRAGE_EXECUTOR_SECRET=replace_with_generated_executor_secret
ARBITRAGE_MAX_EXECUTION_WAX=5
ARBITRAGE_EXECUTION_COOLDOWN_MINUTES=30
ARBITRAGE_BALANCE_WAIT_SECONDS=30
